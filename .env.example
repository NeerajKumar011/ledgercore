# .env.example — LedgerCore environment variable template
# Copy this file to .env, fill in real values, and NEVER commit .env.
# All values here are placeholders; no real credentials are present.

POSTGRES_DB=ledgercore
POSTGRES_USER=ledger_user
POSTGRES_PASSWORD=change_me_before_use
DB_HOST=localhost
DB_PORT=5432

# Authentication & Security (Phase 4)
JWT_SECRET=change_me_to_at_least_32_bytes_of_random_secret_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_at_least_12_chars
